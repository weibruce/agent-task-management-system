{
  "name": "atms-worker",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Atms TypeScript Worker runtime for Claude Agent SDK and compatible agent backends.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "postinstall": "cd ../atms_protocol && npm ci",
    "build": "tsc && node -e \"const{cpSync,mkdirSync,existsSync}=require('fs');const p=require('path');const d=p.resolve('dist/dsh');if(!existsSync(d))mkdirSync(d,{recursive:true});cpSync(p.resolve('dsh/atms.cordis.yml'),p.resolve(d,'atms.cordis.yml'))\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "audit": "npm audit --audit-level=high"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.257",
    "@deepseek-ai/dsh-sdk-client": "0.1.2-rc.1",
    "@moonshot-ai/kimi-agent-sdk": "^0.1.8",
    "@moonshot-ai/kimi-code": "^0.24.2",
    "@openai/codex": "0.145.0",
    "atms-protocol": "file:../atms_protocol",
    "ws": "^8.18.0",
    "zod": "^3.25.0 || ^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.10",
    "typescript": "^5.7.0",
    "vitest": "^4.1.8"
  }
}
