{
  "name": "atms-cli",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Atms TypeScript CLI for configuring, running, and inspecting DAG workflows.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/cli.js",
  "bin": {
    "atms": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dev": "tsx src/cli.ts"
  },
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "atms-plugin-sdk": "file:../atms_plugin_sdk",
    "atms-protocol": "file:../atms_protocol"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "esbuild": "^0.28.1",
    "tsx": "^4.22.4",
    "typescript": "^5.4.0",
    "vitest": "^4.1.8"
  }
}
