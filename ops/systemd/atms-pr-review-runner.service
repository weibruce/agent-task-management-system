[Unit]
Description=Atms GitHub Actions stable PR Review runner
After=network-online.target atms-production.service
Wants=network-online.target atms-production.service

[Service]
Type=simple
WorkingDirectory=%h
EnvironmentFile=%h/.config/atms/production.env
EnvironmentFile=%h/.config/atms/automation.env
ExecStart=/usr/bin/env bash -lc 'exec "$ATMS_PR_REVIEW_RUNNER_ROOT/run.sh"'
Restart=always
RestartSec=5
Nice=10
CPUQuota=600%
MemoryMax=14G
TasksMax=4096
KillMode=control-group
TimeoutStopSec=120

[Install]
WantedBy=default.target
